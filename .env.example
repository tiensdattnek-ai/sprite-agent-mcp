# Copy to .env for local development (never commit secrets).
# All of these are OPTIONAL. Agents must not create or edit this file.

# The ONLY directory the server may write artwork into.
SPRITE_OUTPUT_DIR=./sprite-output

# Set to 0 to disable session autosave (.sprite-agent-state.json).
SPRITE_AUTOSAVE=1

# HTTP mode: npx -y sprite-agent-mcp --http --port 3100
SPRITE_HTTP_PORT=3100
SPRITE_HTTP_HOST=0.0.0.0
SPRITE_HTTP_TOKEN=

# Security hardening for exposed HTTP deployments.
SPRITE_STRICT_HOSTS=0
SPRITE_ALLOWED_HOSTS=

# Human operators only. Agents must not enable this.
SPRITE_ALLOW_EXTERNAL_OUTPUT=0
